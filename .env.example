# Copy this file to .env.local (for your computer) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit real values. .env.local is ignored by git.

# The public address of your site (no trailing slash). Used in email links.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.uk

# The town/area you're launching in, shown on the home page.
NEXT_PUBLIC_SERVICE_AREA=Your Town

# Supabase → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# SECRET: full database access. Server only, never share it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Resend → API Keys. SECRET.
RESEND_API_KEY=re_xxxxxxxx
# Must use the domain you verified in Resend.
EMAIL_FROM="Fixwell <bookings@your-domain.co.uk>"

# Who can open /admin (comma-separated). Create this login in Supabase → Authentication → Users.
ADMIN_EMAILS=you@example.com
# Where copies of bookings and new applications are sent (you).
NOTIFY_EMAIL=you@example.com

# SECRET: random text, at least 32 characters. Makes the customers' private booking links.
# Changing it later breaks links in emails already sent.
BOOKING_LINK_SECRET=replace-with-a-long-random-string

# SECRET: random text. Vercel sends it when running the daily housekeeping job.
CRON_SECRET=replace-with-another-long-random-string

# Show the "[TEST]" example tradespeople? Set to false before launch.
SHOW_TEST_DATA=true
